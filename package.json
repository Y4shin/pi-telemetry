{
  "name": "@y4shin/pi-telemetry",
  "version": "0.5.0",
  "type": "module",
  "description": "Local-first observability extension for Pi",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Y4shin/pi-telemetry.git"
  },
  "homepage": "https://github.com/Y4shin/pi-telemetry",
  "files": [
    "index.ts",
    "src",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills/telemetry-eval-setup",
      "./skills/telemetry-eval-analyze"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^26.6.6",
    "typebox": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "node scripts/release.mjs"
  },
  "overrides": {
    "undici": "^8.12.3"
  }
}
